{
  "info": {
    "name": "VMS - Auth Module",
    "description": "Authentication endpoints for the Vendor Management System backend: login, refresh, logout, current user. Run requests top-to-bottom in the \"Happy Path\" folder to exercise the full token lifecycle; the \"Negative Cases\" folder is independent.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "email", "value": "superadmin@vms.local" },
    { "key": "password", "value": "ChangeMe123!" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "1. Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns tokens and user', () => {",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "  pm.expect(body.data.refreshToken).to.be.a('string');",
                  "  pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get current user (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the logged-in user', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.email).to.eql(pm.collectionVariables.get('email'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a new token pair', () => {",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "  pm.expect(body.data.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "5. Refresh after logout (should fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 — revoked token cannot be reused', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Negative Cases",
      "item": [
        {
          "name": "Login with invalid password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"definitely-wrong\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic error message (no email/password hint)', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Invalid email or password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with malformed body (validation)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Has field errors for email and password', () => {",
                  "  const errors = pm.response.json().errors;",
                  "  pm.expect(errors).to.have.property('email');",
                  "  pm.expect(errors).to.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user with invalid token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not-a-real-token" }],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Get current user with no token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Refresh with invalid token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"not-a-real-refresh-token\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
