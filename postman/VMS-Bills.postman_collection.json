{
  "info": {
    "name": "VMS - Bill Module",
    "description": "Vendor bills — creation against an Approved Quotation, invoice upload, submission (kicks off the background AI 3-way verification pipeline), Director Financial Approval, Accounts verification, and Payment Department status updates. Self-contained: the \"Happy Path\" folder logs in as the seeded Super Admin, creates a fresh Department + HOD + Department User, two Directors, an Accounts user and a Payment Department user, creates a Vendor, creates and fully approves a Quotation (amount above the default ₹50,000 CEO Approval Limit so it routes to the two Directors), then walks a Bill through its full lifecycle. Run top-to-bottom. IMPORTANT: the \"3. Upload invoice PDF\" request requires a real PDF file to be attached manually in Postman (the 'file' form field) before sending — Postman collections cannot embed a portable binary file reference. The Director Financial Approval step has a short built-in delay to give the background AI verification pipeline (OCR + Rule Engine + Gemini) time to flip the bill to ai_verified; if it is still running (e.g. slow Gemini response), re-run that request. The \"Negative Cases\" folder runs after Happy Path and reuses its tokens/ids.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5007/api/v1" },
    { "key": "superAdminEmail", "value": "superadmin@gmail.com" },
    { "key": "superAdminPassword", "value": "123456789" },
    { "key": "superAdminToken", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "departmentName", "value": "" },
    { "key": "departmentCode", "value": "" },
    { "key": "hodEmail", "value": "" },
    { "key": "hodPassword", "value": "" },
    { "key": "hodToken", "value": "" },
    { "key": "deptUserEmail", "value": "" },
    { "key": "deptUserPassword", "value": "" },
    { "key": "deptUserToken", "value": "" },
    { "key": "director1Email", "value": "" },
    { "key": "director1Password", "value": "" },
    { "key": "director1Token", "value": "" },
    { "key": "director2Email", "value": "" },
    { "key": "director2Password", "value": "" },
    { "key": "director2Token", "value": "" },
    { "key": "accountsEmail", "value": "" },
    { "key": "accountsPassword", "value": "" },
    { "key": "accountsToken", "value": "" },
    { "key": "paymentDeptEmail", "value": "" },
    { "key": "paymentDeptPassword", "value": "" },
    { "key": "paymentDeptToken", "value": "" },
    { "key": "vendorId", "value": "" },
    { "key": "quotationId", "value": "" },
    { "key": "billId", "value": "" }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "1. Login as Super Admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('runId')) {",
                  "  const runId = Date.now().toString();",
                  "  pm.collectionVariables.set('runId', runId);",
                  "  pm.collectionVariables.set('departmentName', 'Bills Dept ' + runId);",
                  "  pm.collectionVariables.set('departmentCode', 'BLD' + runId);",
                  "  pm.collectionVariables.set('hodEmail', 'hod.' + runId + '@vms.local');",
                  "  pm.collectionVariables.set('hodPassword', 'Password123!');",
                  "  pm.collectionVariables.set('deptUserEmail', 'deptuser.' + runId + '@vms.local');",
                  "  pm.collectionVariables.set('deptUserPassword', 'Password123!');",
                  "  pm.collectionVariables.set('director1Email', 'director1.' + runId + '@vms.local');",
                  "  pm.collectionVariables.set('director1Password', 'Password123!');",
                  "  pm.collectionVariables.set('director2Email', 'director2.' + runId + '@vms.local');",
                  "  pm.collectionVariables.set('director2Password', 'Password123!');",
                  "  pm.collectionVariables.set('accountsEmail', 'accounts.' + runId + '@vms.local');",
                  "  pm.collectionVariables.set('accountsPassword', 'Password123!');",
                  "  pm.collectionVariables.set('paymentDeptEmail', 'payment.' + runId + '@vms.local');",
                  "  pm.collectionVariables.set('paymentDeptPassword', 'Password123!');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('superAdminToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "2. Create Department with new HOD",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "url": "{{baseUrl}}/departments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{departmentName}}\",\n  \"code\": \"{{departmentCode}}\",\n  \"createHod\": true,\n  \"hod\": {\n    \"name\": \"Test HOD\",\n    \"email\": \"{{hodEmail}}\",\n    \"password\": \"{{hodPassword}}\"\n  }\n}"
            }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));"] } }
          ]
        },
        {
          "name": "3. Create Director 1 (Super Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Director One\",\n  \"email\": \"{{director1Email}}\",\n  \"password\": \"{{director1Password}}\",\n  \"role\": \"director\"\n}"
            }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));"] } }
          ]
        },
        {
          "name": "4. Create Director 2 (Super Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Director Two\",\n  \"email\": \"{{director2Email}}\",\n  \"password\": \"{{director2Password}}\",\n  \"role\": \"director\"\n}"
            }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));"] } }
          ]
        },
        {
          "name": "5. Create Accounts user (Super Admin)",
          "request": {
            "method": "POST",
            "header": [
