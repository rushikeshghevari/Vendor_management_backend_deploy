                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('deptUserToken', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Login as Director 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{director1Email}}\",\n  \"password\": \"{{director1Password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('director1Token', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Login as Director 2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{director2Email}}\",\n  \"password\": \"{{director2Password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('director2Token', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "12. Login as Accounts",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{accountsEmail}}\",\n  \"password\": \"{{accountsPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accountsToken', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "13. Login as Payment Department",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{paymentDeptEmail}}\",\n  \"password\": \"{{paymentDeptPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('paymentDeptToken', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "14. Create Vendor (Department User)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{deptUserToken}}" }
            ],
            "url": "{{baseUrl}}/vendors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Supplies\",\n  \"contactPerson\": \"John Doe\",\n  \"phone\": \"9876543210\",\n  \"email\": \"vendor@example.com\",\n  \"address\": \"123 Industrial Area\",\n  \"state\": \"Maharashtra\",\n  \"district\": \"Mumbai\",\n  \"city\": \"Mumbai\",\n  \"pincode\": \"400001\",\n  \"bankDetails\": {\n    \"bankName\": \"HDFC Bank\",\n    \"accountHolderName\": \"Acme Supplies\",\n    \"accountNumber\": \"123456789012\",\n    \"ifscCode\": \"HDFC0001234\"\n  },\n  \"category\": \"Raw Materials\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('vendorId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "15. Create Quotation (above CEO Approval Limit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{deptUserToken}}" }
            ],
            "url": "{{baseUrl}}/quotations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor\": \"{{vendorId}}\",\n  \"quotationDate\": \"2026-07-10\",\n  \"requiredDate\": \"2026-08-10\",\n  \"amount\": 90000,\n  \"gst\": 18,\n  \"currency\": \"INR\",\n  \"paymentTerms\": \"Net 30\",\n  \"deliveryTerms\": \"FOB destination\",\n  \"priority\": \"high\",\n  \"description\": \"Bulk raw material order\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Quotation created in draft status', () => pm.expect(body.data.status).to.eql('draft'));",
                  "pm.collectionVariables.set('quotationId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "16. Submit Quotation",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{deptUserToken}}" }],
            "url": "{{baseUrl}}/quotations/{{quotationId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Quotation is now submitted', () => pm.expect(body.data.status).to.eql('submitted'));"
                ]
              }
            }
          ]
        },
        {
          "name": "17. Director 1 approves",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{director1Token}}" }
            ],
            "url": "{{baseUrl}}/quotations/{{quotationId}}/decision",
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"approved\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "18. Director 2 approves (fully approved)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{director2Token}}" }
            ],
            "url": "{{baseUrl}}/quotations/{{quotationId}}/decision",
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"approved\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Quotation is now fully Approved', () => pm.expect(body.data.status).to.eql('approved'));"
                ]
              }
            }
          ]
        },
        {
          "name": "19. Create Bill against the Approved Quotation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{deptUserToken}}" }
            ],
            "url": "{{baseUrl}}/bills",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quotation\": \"{{quotationId}}\",\n  \"invoiceNumber\": \"INV-1001\",\n  \"invoiceDate\": \"2026-07-10\",\n  \"invoiceAmount\": 100000,\n  \"taxableAmount\": 84746,\n  \"gstAmount\": 15254,\n  \"paymentTerms\": \"Net 30\",\n  \"dueDate\": \"2026-08-10\",\n  \"remarks\": \"Initial invoice for bulk order\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Bill created in draft status', () => {",
                  "  pm.expect(body.data.id).to.be.a('string');",
                  "  pm.expect(body.data.billCode).to.match(/^[A-Z]+-BILL/);",
                  "  pm.expect(body.data.status).to.eql('draft');",
                  "});",
                  "pm.collectionVariables.set('billId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "20. Upload invoice PDF (attach a PDF file manually)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{deptUserToken}}" }],
            "url": "{{baseUrl}}/bills/{{billId}}/invoice",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "Select a PDF invoice file before sending this request." }
              ]
            },
            "description": "Postman collections cannot embed a portable binary file reference — before sending, click this field and choose any local PDF file. The bill cannot be submitted (next step) without this upload."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Invoice file recorded', () => pm.expect(body.data.invoiceFiles).to.have.lengthOf.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "21. Submit Bill to Accounts (kicks off background AI verification)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{deptUserToken}}" }],
            "url": "{{baseUrl}}/bills/{{billId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Bill is now submitted', () => pm.expect(body.data.status).to.eql('submitted'));"
                ]
              }
            }
          ]
        },
        {
          "name": "22. Director Financial Approval (approved)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{director1Token}}" }
            ],
            "url": "{{baseUrl}}/bills/{{billId}}/financial-decision",
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"approved\"\n}" }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// The 3-way AI verification pipeline (OCR + Rule Engine + Gemini) runs in the background",
                  "// after Submit and must finish (bill status -> ai_verified) before a Director can act.",
                  "// Give it a head start here. If this request still 404s, the pipeline is slow (e.g. Gemini",
                  "// latency) — simply re-run this request a few seconds later.",
                  "const start = Date.now();",
                  "while (Date.now() - start < 10000) { /* busy-wait for background AI pipeline */ }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Director financially approved the bill', () => {",
                  "  pm.expect(body.data.directorFinancialDecision).to.eql('approved');",
                  "  pm.expect(body.data.status).to.eql('director_approved');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "23. Accounts verifies the Bill",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accountsToken}}" }
            ],
            "url": "{{baseUrl}}/bills/{{billId}}/decision",
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"verified\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Bill is now verified', () => pm.expect(body.data.status).to.eql('verified'));"
                ]
              }
            }
          ]
        },
        {
          "name": "24. Payment Department sets payment_pending",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{paymentDeptToken}}" }
            ],
            "url": "{{baseUrl}}/bills/{{billId}}/payment-status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"payment_pending\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Bill payment status updated', () => pm.expect(body.data.status).to.eql('payment_pending'));"
                ]
              }
            }
          ]
        },
        {
          "name": "25. List bills (filtered by quotation)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{deptUserToken}}" }],
            "url": "{{baseUrl}}/bills?quotation={{quotationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('The bill created earlier is present', () => {",
                  "  pm.expect(body.data.some((b) => b.id === pm.collectionVariables.get('billId'))).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "26. Get bill by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{deptUserToken}}" }],
            "url": "{{baseUrl}}/bills/{{billId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the bill created earlier', () => pm.expect(body.data.id).to.eql(pm.collectionVariables.get('billId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Negative Cases",
      "item": [
        {
          "name": "Create a duplicate bill for the same Quotation (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{deptUserToken}}" }
            ],
            "url": "{{baseUrl}}/bills",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quotation\": \"{{quotationId}}\",\n  \"invoiceNumber\": \"INV-1002-DUP\",\n  \"invoiceDate\": \"2026-07-11\",\n  \"invoiceAmount\": 5000,\n  \"taxableAmount\": 4237,\n  \"gstAmount\": 763,\n  \"paymentTerms\": \"Net 30\",\n  \"dueDate\": \"2026-08-11\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 — a bill already exists for this quotation', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Accounts decision attempted by a Director (wrong role)",
          "request": {
            "method": "PATCH",
