              "raw": "{\n  \"name\": \"Accounts User\",\n  \"email\": \"{{accountsEmail}}\",\n  \"password\": \"{{accountsPassword}}\",\n  \"role\": \"accounts\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
