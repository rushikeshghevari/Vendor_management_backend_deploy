{
  "info": {
    "name": "VMS - Users Module",
    "description": "User self-service (password) plus Super Admin user management CRUD for the Vendor Management System backend. Run requests top-to-bottom in the \"Happy Path\" folder — it logs in as Super Admin, creates users of a couple of roles, then exercises list/get/update/status/bulk-status/reset-password/delete and the self-service password change. The \"Negative Cases\" folder assumes the Happy Path folder has already run (it reuses {{accessToken}} and {{createdUserEmail}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5007/api/v1" },
    { "key": "email", "value": "superadmin@gmail.com" },
    { "key": "password", "value": "123456789" },
    { "key": "accessToken", "value": "" },
    { "key": "superAdminUserId", "value": "" },
    { "key": "createdUserEmail", "value": "" },
    { "key": "createdUserPassword", "value": "Password123!" },
    { "key": "createdUserId", "value": "" },
    { "key": "bulkUserId", "value": "" },
    { "key": "selfPassword", "value": "Password123!" },
    { "key": "secondUserId", "value": "" },
    { "key": "secondUserEmail", "value": "" },
    { "key": "secondUserPassword", "value": "Password123!" },
    { "key": "secondUserAccessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "1. Login as Super Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns an access token and user id', () => {",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "  pm.expect(body.data.user.id).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "pm.collectionVariables.set('superAdminUserId', body.data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create a user (director role, no department needed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Regional Director\",\n  \"email\": \"{{createdUserEmail}}\",\n  \"password\": \"{{createdUserPassword}}\",\n  \"role\": \"director\",\n  \"phone\": \"9988776655\",\n  \"isActive\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('createdUserEmail', `director.${Date.now()}@vms.local`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns created user', () => {",
                  "  pm.expect(body.data._id).to.be.a('string');",
                  "  pm.expect(body.data.role).to.eql('director');",
                  "  pm.expect(body.data.email).to.eql(pm.collectionVariables.get('createdUserEmail'));",
                  "});",
                  "pm.collectionVariables.set('createdUserId', body.data._id);",
                  "pm.collectionVariables.set('bulkUserId', body.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Create a second user (accounts role, for bulk-status test)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Accounts Payable\",\n  \"email\": \"{{secondUserEmail}}\",\n  \"password\": \"{{secondUserPassword}}\",\n  \"role\": \"accounts\",\n  \"isActive\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('secondUserEmail', `accounts.${Date.now()}@vms.local`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns created user', () => {",
                  "  pm.expect(body.data.role).to.eql('accounts');",
                  "});",
                  "pm.collectionVariables.set('secondUserId', body.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns an array with pagination', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.pagination).to.have.property('total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. List users with search and sort",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users?search=Director&sort=name&order=asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns an array', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Get user by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/{{createdUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the created user', () => {",
                  "  pm.expect(body.data._id).to.eql(pm.collectionVariables.get('createdUserId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Update user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users/{{createdUserId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Regional Director (Updated)\",\n  \"phone\": \"9988776600\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the updated user', () => {",
                  "  pm.expect(body.data.name).to.eql('Regional Director (Updated)');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Set user status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users/{{createdUserId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('User is now inactive', () => {",
                  "  pm.expect(body.data.isActive).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Bulk update user status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users/bulk-status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\"{{bulkUserId}}\"],\n  \"isActive\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns updated count', () => {",
                  "  pm.expect(body.data.updated).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Reset user password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users/{{createdUserId}}/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewPassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Change own password (/users/me/password)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users/me/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 (password changed back to itself so subsequent reruns keep working)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "12. Delete (deactivate) user",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/{{createdUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Negative Cases",
      "item": [
        {
          "name": "Setup: Login as non-Super-Admin user (accounts role)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{secondUserEmail}}\",\n  \"password\": \"{{secondUserPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 (requires Happy Path folder to have run first)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('secondUserAccessToken', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user with duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Email User\",\n  \"email\": \"{{createdUserEmail}}\",\n  \"password\": \"Password123!\",\n  \"role\": \"director\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 (requires Happy Path to have run first so createdUserEmail exists)', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create department_user/hod without department (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Department User\",\n  \"email\": \"no.dept.{{$timestamp}}@vms.local\",\n  \"password\": \"Password123!\",\n  \"role\": \"department_user\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Has field error for department', () => {",
                  "  const errors = pm.response.json().errors;",
                  "  pm.expect(errors).to.have.property('department');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Non-Super-Admin accessing /users (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{secondUserAccessToken}}" }],
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 (accounts role is not super_admin)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate own Super Admin account (403)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/{{superAdminUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 (service guards against a Super Admin deactivating themselves, requires Happy Path to have run first)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate own Super Admin account via status endpoint (403)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users/{{superAdminUserId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get non-existent user (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/64b64b64b64b64b64b64b64"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change own password with wrong current password (400)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users/me/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"definitely-wrong\",\n  \"newPassword\": \"AnotherPassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 (service throws ApiError.badRequest for an incorrect current password)', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
